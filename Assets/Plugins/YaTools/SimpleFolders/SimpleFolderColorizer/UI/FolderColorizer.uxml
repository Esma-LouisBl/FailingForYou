<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/YaTools/SimpleFolders/SimpleFolderColorizer/UI/FolderColorizer.uss?fileID=7433441132597879392&amp;guid=45ea5c16fb26bc34f8c254637a244715&amp;type=3#FolderColorizer" />
    <ui:ScrollView>
        <ui:VisualElement style="flex-grow: 1; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
            <ui:VisualElement style="flex-grow: 0; align-self: stretch; justify-content: space-between; flex-direction: row; align-items: center; align-content: flex-start; flex-shrink: 0; margin-bottom: 2px;">
                <ui:VisualElement style="flex-grow: 0; align-self: flex-start; justify-content: space-around; flex-direction: row; align-items: center; align-content: flex-start; flex-shrink: 0; margin-bottom: 2px;">
                    <ui:Button text="+" name="color-add-button" tooltip="Add New Color" style="width: 40px; height: 40px; align-self: flex-start; align-items: flex-start; padding-top: 0; padding-right: 0; padding-bottom: 3px; padding-left: 0; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; font-size: 24px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(36, 36, 36); border-left-color: rgb(36, 36, 36); border-right-color: rgb(36, 36, 36); -unity-background-image-tint-color: rgb(65, 65, 65);" />
                    <ui:Button text="×" name="color-remove-button" tooltip="Reset Color (Default)" style="width: 40px; height: 40px; align-self: flex-start; align-items: flex-start; padding-top: 0; padding-right: 0; padding-bottom: 3px; padding-left: 0; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; font-size: 24px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(36, 36, 36); border-left-color: rgb(36, 36, 36); border-right-color: rgb(36, 36, 36); color: rgb(255, 255, 255); -unity-background-image-tint-color: rgb(65, 65, 65);" />
                    <ui:Button name="color-rainbow-button" tooltip="Rainbow: color selected folders in a gradient" style="width: 40px; height: 40px; align-self: flex-start; align-items: flex-start; padding-top: 0; padding-right: 0; padding-bottom: 3px; padding-left: 0; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; font-size: 24px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-color: rgb(36, 36, 36); border-left-color: rgb(36, 36, 36); border-right-color: rgb(36, 36, 36); color: rgb(255, 255, 255); background-image: url(&quot;project://database/Assets/YaTools/SimpleFolders/SimpleFolderColorizer/Textures/UI_RainbowButton.png?fileID=2800000&amp;guid=6d751d287c93a1d4386599ff0e51f914&amp;type=3#UI_RainbowButton&quot;);" />
                </ui:VisualElement>
                <ui:Button text="Manage Presets..." name="manage-presets-button" style="width: 144px; height: 40px; align-self: center; align-items: auto; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-left-color: rgb(36, 36, 36); border-right-color: rgb(36, 36, 36); border-top-color: rgb(36, 36, 36); font-size: 14px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; justify-content: flex-start;" />
